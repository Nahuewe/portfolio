---
import Layout from "@/layouts/Layout.astro"
import ExternalLink from "@/components/icons/ExternalLink.astro"
import GitHub from "@/components/icons/GitHub.astro"
import LinkButton from "@/components/LinkButton.astro"
import { getProjects, hasCaseStudy, type Project } from "@/data"
import { useTranslations, getLocalizedPath, langs, type Lang } from "@/i18n/utils"
import { defaultLang } from "@/i18n/ui"

// Only projects with case-study content get their own page.
export function getStaticPaths() {
  return langs.flatMap((lang) =>
    getProjects(lang)
      .filter(hasCaseStudy)
      .map((project) => ({
        params: { lang: lang === defaultLang ? undefined : lang, slug: project.slug },
        props: { lang, project },
      })),
  )
}

const { lang, project } = Astro.props as { lang: Lang; project: Project }
const t = useTranslations(lang)

const availableLangs = langs.filter((l) =>
  getProjects(l).some((p) => p.slug === project.slug && hasCaseStudy(p)),
)

const sections = [
  { title: t("projects.problem"), body: project.problem },
  { title: t("projects.decision"), body: project.decision },
  { title: t("projects.result"), body: project.result },
].filter((s) => s.body)
---

<Layout
  lang={lang}
  title={`${project.title} · ${t("meta.title")}`}
  description={project.description}
  path={`/projects/${project.slug}`}
  availableLangs={availableLangs}
>
  <main id="main" class="px-4 pb-16 pt-32">
    <article class="container mx-auto w-full md:max-w-2xl lg:max-w-4xl">
      <a
        href={`${getLocalizedPath(lang, "/")}#projects`}
        class="font-mono text-sm text-sello-500 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-sello-500 dark:text-sello-400"
      >
        ← {t("nav.back")}
      </a>

      <h1 class="mt-6 text-4xl font-extrabold tracking-tight">{project.title}</h1>
      <p class="mt-1 text-neutral-500">{project.org}</p>
      <p class="mt-6 max-w-2xl text-pretty text-lg text-neutral-700 dark:text-neutral-300">{project.description}</p>

      {
        sections.map((s) => (
          <section class="mt-10 max-w-2xl">
            <h2 class="text-xl font-bold">{s.title}</h2>
            <p class="mt-2 text-pretty text-neutral-700 dark:text-neutral-300">{s.body}</p>
          </section>
        ))
      }

      <section class="mt-10 max-w-2xl">
        <h2 class="text-xl font-bold">{t("projects.highlights")}</h2>
        <ul class="mt-3 space-y-2 text-neutral-700 dark:text-neutral-300">
          {
            project.highlights.map((h) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="text-sello-500 dark:text-sello-400">—</span>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        project.media && project.media.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {project.media.map((m) => (
              <img src={m.src} alt={m.alt} loading="lazy" class="w-full border border-black/15 dark:border-white/15" />
            ))}
          </div>
        )
      }

      <p class="mt-8 font-mono text-xs text-neutral-500">{project.tags.join("  ·  ")}</p>

      {
        (project.link || project.github) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {project.link && (
              <LinkButton href={project.link}>
                <ExternalLink class="size-4" />
                {t("projects.preview")}
              </LinkButton>
            )}
            {project.github && (
              <LinkButton href={project.github}>
                <GitHub class="size-5" />
                {t("projects.code")}
              </LinkButton>
            )}
          </div>
        )
      }
    </article>
  </main>
</Layout>
