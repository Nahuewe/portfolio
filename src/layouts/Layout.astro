---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { useTranslations, getLocalizedPath, langs, type Lang } from "@/i18n/utils";
import { SITE } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path without locale prefix ("/" or "/projects/foo"); used for canonical and hreflang. */
  path?: string;
  /** Languages in which this page exists. */
  availableLangs?: Lang[];
  image?: string;
  noindex?: boolean;
}

const {
  description,
  title,
  lang,
  path = "/",
  availableLangs = langs,
  image = SITE.ogImage,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);

const abs = (p: string) => new URL(p, SITE.url).toString();
const canonical = abs(getLocalizedPath(lang, path));
const ogImage = abs(image);
const ogLocale = lang === "en" ? "en_US" : "es_AR";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  sameAs: [SITE.linkedin, SITE.github],
  jobTitle: t("person.jobTitle"),
  worksFor: {
    "@type": "Organization",
    name: SITE.employer,
  },
};

const analyticsDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Canonical + language alternates -->
    <link rel="canonical" href={canonical} />
    {
      availableLangs.length > 1 &&
        availableLangs.map((l) => (
          <link rel="alternate" hreflang={l} href={abs(getLocalizedPath(l, path))} />
        ))
    }
    {
      availableLangs.length > 1 && (
        <link rel="alternate" hreflang="x-default" href={abs(getLocalizedPath("es", path))} />
      )
    }

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={`${SITE.name} · Portfolio`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="darkreader-lock" />

    <!-- Apply the saved (or system) theme before first paint and after every view transition -->
    <script is:inline>
      (function () {
        function preferred() {
          try {
            var saved = localStorage.getItem("theme");
            if (saved === "light" || saved === "dark") return saved;
          } catch (e) {}
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        function apply(root) {
          root.classList.toggle("dark", preferred() === "dark");
        }
        apply(document.documentElement);
        document.addEventListener("astro:before-swap", function (e) {
          apply(e.newDocument.documentElement);
        });
      })();
    </script>

    <ClientRouter />

    {
      analyticsDomain && (
        <script is:inline defer data-domain={analyticsDomain} src="https://plausible.io/js/script.tagged-events.js" />
      )
    }
  </head>

  <body class="relative bg-white text-black dark:bg-gray-950 dark:text-white">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-sello-600 focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      {t("a11y.skip")}
    </a>
    <div
      class="pointer-events-none fixed inset-0 z-[-1] opacity-[0.035] dark:opacity-[0.05]"
      style="background-image: url('/noise.svg'); background-size: 200px 200px;"
      aria-hidden="true"
    >
    </div>
    <Header lang={lang} path={path} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
