---
import { useTranslations, type Lang } from "@/i18n/utils"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const services = t("services.list")
---

<ul class="grid gap-x-10 border-t border-black/15 dark:border-white/15 md:grid-cols-2">
  {
    services.map((service, i) => (
      <li class="flex gap-4 border-b border-black/15 py-3 dark:border-white/15">
        <span class="font-mono text-sm text-neutral-500">{String(i + 1).padStart(2, "0")}</span>
        <span class="font-medium">{service}</span>
      </li>
    ))
  }
</ul>
