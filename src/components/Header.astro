---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { useTranslations, getLocalizedPath, type Lang } from "@/i18n/utils";
import { CV } from "@/data/site";

interface Props {
  lang: Lang;
  /** Path without locale prefix, used by the language switcher. */
  path?: string;
}

const { lang, path = "/" } = Astro.props;
const t = useTranslations(lang);
const home = getLocalizedPath(lang, "/");
const cvHref = CV[lang];

const navItems = [
  { title: t("nav.projects"), id: "projects" },
  { title: t("nav.experience"), id: "experience" },
  { title: t("nav.services"), id: "services" },
  { title: t("nav.about"), id: "about" },
].map((item) => ({ ...item, url: `${home}#${item.id}` }));

const contactUrl = `${home}#contact`;

const panel =
  "rounded-2xl border border-gray-200/20 bg-white/80 shadow-lg backdrop-blur-xl dark:bg-gray-900/80";
const iconButtonLink =
  "rounded-xl px-4 py-3 transition-colors hover:bg-sello-500/10 hover:text-sello-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sello-500";
---

<header class="fixed top-4 z-50 w-full px-4">
  <div class="mx-auto max-w-6xl">

    <!-- MOBILE -->
    <div class={`flex items-center justify-between px-4 py-3 md:hidden ${panel}`}>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="cursor-pointer text-sm font-medium text-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sello-500 dark:text-gray-200"
      >
        <span aria-hidden="true">☰</span> {t("nav.menu")}
      </button>

      <div class="flex items-center gap-2">
        <LanguageToggle lang={lang} path={path} />
        <ThemeToggle lang={lang} />
      </div>
    </div>

    <!-- MOBILE MENU -->
    <div id="mobile-menu" class={`mt-2 hidden p-4 md:hidden ${panel}`}>
      <div class="flex flex-col gap-2">
        {
          navItems.map((link) => (
            <a href={link.url} class={iconButtonLink}>
              {link.title}
            </a>
          ))
        }

        <a
          href={cvHref}
          download
          class="plausible-event-name=CV+Download cursor-pointer rounded-xl border border-sello-500/30 px-4 py-3 text-center font-semibold text-sello-500 transition-colors hover:bg-sello-500/10"
        >
          {t("nav.cv")}
        </a>

        <a
          href={contactUrl}
          class="mt-2 cursor-pointer rounded-xl bg-sello-600 px-4 py-3 text-center font-semibold text-white transition-all hover:bg-sello-500"
        >
          {t("nav.contact")}
        </a>
      </div>
    </div>

    <!-- DESKTOP -->
    <nav
      aria-label={t("nav.main")}
      class="header-nav mx-auto hidden w-fit items-center justify-center gap-1 rounded-full px-3 py-2 md:flex"
    >
      {
        navItems.map((link) => (
          <a
            class="nav-link relative rounded-full px-3 py-2 text-sm transition-colors duration-200 hover:text-sello-500 dark:hover:text-sello-400"
            data-nav={link.id}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }

      <a
        href={cvHref}
        download
        class="plausible-event-name=CV+Download ml-2 cursor-pointer rounded-full border border-sello-500/30 px-4 py-2 text-sm font-semibold text-sello-500 transition-colors hover:bg-sello-500/10"
      >
        {t("nav.cv")}
      </a>

      <a
        href={contactUrl}
        class="ml-2 cursor-pointer rounded-full bg-sello-600 px-4 py-2 text-sm font-semibold text-white transition-all hover:scale-105 hover:bg-sello-500"
      >
        {t("nav.contact")}
      </a>

      <div class="ml-2 flex items-center gap-2 border-l border-gray-300/30 pl-2 dark:border-white/10">
        <LanguageToggle lang={lang} path={path} />
        <ThemeToggle lang={lang} />
      </div>
    </nav>

  </div>
</header>

<script>
  document.addEventListener("keydown", (e) => {
    const menuButton = document.getElementById("menu-toggle");
    if (e.key === "Escape" && menuButton?.getAttribute("aria-expanded") === "true") {
      menuButton.click();
      menuButton.focus();
    }
  });

  document.addEventListener("astro:page-load", () => {
    const menuButton = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

    const setOpen = (open: boolean) => {
      mobileMenu?.classList.toggle("hidden", !open);
      menuButton?.setAttribute("aria-expanded", String(open));
    };

    menuButton?.addEventListener("click", () => {
      setOpen(menuButton.getAttribute("aria-expanded") !== "true");
    });

    mobileMenu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

    const navLinks = document.querySelectorAll<HTMLElement>(".nav-link");
    const activeClasses = ["text-sello-500", "dark:text-sello-400", "bg-sello-500/10", "font-semibold"];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((link) => {
            const active = link.dataset.nav === entry.target.id;
            activeClasses.forEach((c) => link.classList.toggle(c, active));
            if (active) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          });
        });
      },
      { threshold: 0.35 },
    );

    document.querySelectorAll("section[id]").forEach((section) => observer.observe(section));
  });
</script>
