---
import { getLocalizedPath, type Lang } from "@/i18n/utils"

interface Props {
  lang: Lang
  /** Path without locale prefix, e.g. "/" or "/projects/foo" */
  path?: string
}

const { lang, path = "/" } = Astro.props
const other: Lang = lang === "es" ? "en" : "es"
const ariaLabel = lang === "es" ? "Switch to English" : "Cambiar a español"
---

<a
  href={getLocalizedPath(other, path)}
  hreflang={other}
  lang={other}
  class="lang-toggle inline-flex size-8 items-center justify-center rounded-full border border-gray-300/60 text-xs font-semibold text-gray-700 transition-colors hover:border-sello-400 hover:text-sello-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sello-500 dark:border-gray-600/60 dark:text-gray-200 dark:hover:border-sello-400 dark:hover:text-sello-400"
  aria-label={ariaLabel}
>
  {other.toUpperCase()}
</a>

<script>
  // Keep the current #section when switching language.
  const sync = () => {
    document.querySelectorAll<HTMLAnchorElement>(".lang-toggle").forEach((a) => {
      a.hash = window.location.hash
    })
  }
  document.addEventListener("astro:page-load", sync)
  window.addEventListener("hashchange", sync)
</script>
