---
import ExternalLink from "./icons/ExternalLink.astro"
import GitHub from "./icons/GitHub.astro"
import LinkButton from "./LinkButton.astro"
import projectsEs from "@/data/es/projects.json"
import projectsEn from "@/data/en/projects.json"
import { useTranslations, type Lang } from "@/i18n/utils"

interface Project {
  title: string
  org: string
  access: "public" | "login" | "personal"
  description: string
  highlights: string[]
  tags: string[]
  link?: string
  github?: string
  media?: { src: string; alt: string }[]
}

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const PROJECTS = (lang === "en" ? projectsEn : projectsEs) as Project[]
const accessLabel = {
  public: t("projects.access.public"),
  login: t("projects.access.login"),
  personal: t("projects.access.personal"),
}
const tagClass = "font-mono text-xs uppercase tracking-wider text-sello-500 dark:text-sello-400"
---

<p class="mb-8 max-w-2xl text-pretty text-neutral-600 dark:text-neutral-400">
  {t("projects.subtitle")}
</p>

<ol class="border-t border-black/15 dark:border-white/15">
  {
    PROJECTS.map((p, i) => (
      <li class="border-b border-black/15 dark:border-white/15">
        <details class="group" open={i === 0}>
          <summary class="grid cursor-pointer list-none grid-cols-[2rem_1fr_1.5rem] items-baseline gap-x-4 py-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sello-500 sm:grid-cols-[3rem_1fr_9rem_1.5rem] [&::-webkit-details-marker]:hidden">
            <span class="font-mono text-sm text-neutral-500">{String(i + 1).padStart(2, "0")}</span>
            <span>
              <span class="block text-lg font-bold text-neutral-900 dark:text-white">{p.title}</span>
              <span class="block text-sm text-neutral-500">{p.org}</span>
              <span class={`mt-1 block sm:hidden ${tagClass}`}>{accessLabel[p.access]}</span>
            </span>
            <span class={`hidden sm:block ${tagClass}`}>{accessLabel[p.access]}</span>
            <span aria-hidden="true" class="font-mono text-lg text-neutral-500 transition-transform group-open:rotate-45 motion-reduce:transition-none">+</span>
          </summary>

          <div class="pb-8 pl-12 sm:pl-16">
            <p class="max-w-2xl text-pretty text-neutral-700 dark:text-neutral-300">{p.description}</p>

            <ul class="mt-4 max-w-2xl space-y-2 text-sm text-neutral-700 dark:text-neutral-300">
              {p.highlights.map((h) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="text-sello-500 dark:text-sello-400">—</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            {p.media && p.media.length > 0 && (
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                {p.media.map((m) => (
                  <img src={m.src} alt={m.alt} loading="lazy" class="w-full border border-black/15 dark:border-white/15" />
                ))}
              </div>
            )}

            <p class="mt-5 font-mono text-xs text-neutral-500">{p.tags.join("  ·  ")}</p>

            {(p.github || p.link) && (
              <div class="mt-5 flex flex-wrap items-center gap-3">
                {p.link && (
                  <LinkButton href={p.link}>
                    <ExternalLink class="size-4" />
                    {t("projects.preview")}
                  </LinkButton>
                )}
                {p.github && (
                  <LinkButton href={p.github}>
                    <GitHub class="size-5" />
                    {t("projects.code")}
                  </LinkButton>
                )}
              </div>
            )}

            {p.access === "login" && !p.link && (
              <p class="mt-5 max-w-2xl border-l-2 border-sello-500 pl-3 text-sm text-neutral-600 dark:text-neutral-400">
                {t("projects.restricted")}
              </p>
            )}
          </div>
        </details>
      </li>
    ))
  }
</ol>
