---
import Badge from "@/components/Badge.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import { useTranslations, type Lang } from "@/i18n/utils";
import { SITE, CV } from "@/data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cvHref = CV[lang];
---

<div class="max-w-4xl">
  <div class="anim-fade-in flex gap-4 mb-6 items-center">
    <a
      href={SITE.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:hover:scale-105 mt-4"
    >
      <Badge>{t("hero.available")}</Badge>
    </a>
  </div>

  <p
    class="anim-fade-in
      anim-delay-1
      text-sm
      uppercase
      tracking-[0.25em]
      text-sello-500
      dark:text-sello-400
      font-medium"
  >
    {t("hero.role")}
  </p>

  <h1
    class="anim-fade-in
      anim-delay-1
      mt-3
      text-4xl
      sm:text-6xl
      font-extrabold
      tracking-tight"
  >
    {t("hero.headline")}
  </h1>

  <p
    class="anim-fade-in
      anim-delay-2
      mt-6
      max-w-3xl
      text-lg
      leading-relaxed
      text-neutral-600
      dark:text-neutral-400"
  >
    {t("hero.intro.before")} <span class="font-semibold text-sello-500">{t("hero.intro.name")}</span>{t("hero.intro.after")}
  </p>

  <dl class="anim-fade-in anim-delay-2 mt-10 grid max-w-2xl grid-cols-3 border-y border-black/15 py-5 dark:border-white/15">
    <div><dd class="text-3xl font-bold text-sello-500 dark:text-sello-400">5+</dd><dt class="mt-1 text-sm text-neutral-500">{t("hero.metric.years")}</dt></div>
    <div><dd class="text-3xl font-bold text-sello-500 dark:text-sello-400">30+</dd><dt class="mt-1 text-sm text-neutral-500">{t("hero.metric.projects")}</dt></div>
    <div><dd class="text-3xl font-bold text-sello-500 dark:text-sello-400">24</dd><dt class="mt-1 text-sm text-neutral-500">{t("hero.metric.modules")}</dt></div>
  </dl>

  <div class="anim-fade-in anim-delay-3 mt-8">
    <p class="mb-2 font-mono text-xs uppercase tracking-[0.25em] text-neutral-500">{t("hero.stack.label")}</p>
    <p class="font-mono text-sm text-neutral-700 dark:text-neutral-300">React / Next.js / NestJS / Laravel / Astro / TypeScript / Python / PostgreSQL / Docker</p>
  </div>

  <!-- BOTONES -->
  <nav
    class="anim-fade-in
      anim-delay-3
      flex
      flex-wrap
      gap-4
      mt-10"
    aria-label={t("nav.aria")}
  >
    <a
      href={cvHref}
      download
      class="plausible-event-name=CV+Download inline-flex items-center justify-center gap-2 px-4 py-1 text-white transition bg-sello-600 border border-sello-600 rounded-full text-md hover:bg-sello-500 hover:border-sello-500 max-w-fit focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-sello-700"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M12 15V3" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
      {t("hero.cv")}
    </a>

    <SocialPill href={`mailto:${SITE.email}`}>
      <MailIcon class="size-4" />
      {t("hero.contact")}
    </SocialPill>

    <SocialPill href={SITE.linkedin}>
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>

    <SocialPill href={SITE.github}>
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>
