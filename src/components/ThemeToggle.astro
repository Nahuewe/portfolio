---
import type { Lang } from "@/i18n/utils"
import { useTranslations } from "@/i18n/utils"

interface Props {
  lang: Lang
}

const t = useTranslations(Astro.props.lang)
---

<button
  type="button"
  class="theme-toggle inline-flex size-8 cursor-pointer items-center justify-center rounded-full border border-gray-300/60 text-gray-700 transition-colors hover:border-sello-400 hover:text-sello-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sello-500 dark:border-gray-600/60 dark:text-gray-200 dark:hover:border-sello-400 dark:hover:text-sello-400"
  aria-label={t("theme.toggle")}
>
  <svg class="size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
  <svg class="hidden size-4 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((button) => {
      button.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark")
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light")
        } catch {}
      })
    })
  })
</script>
